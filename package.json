{
  "name": "adonis-cms",
  "version": "0.0.0",
  "private": true,
  "description": "Config-first CMS for the Agora AdonisJS ecosystem \u2014 collections, globals, drafts, i18n and a schema-driven admin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-cms.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm --filter './packages/*' build && changeset publish",
    "version-packages": "changeset version && pnpm install --lockfile-only && biome check --write .",
    "e2e": "playwright test",
    "test:official": "bash scripts/test-official.sh",
    "test:durable": "bash scripts/test-durable.sh",
    "test:auth": "bash scripts/test-auth.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "3.0.1",
    "@playwright/test": "1.56.1",
    "@swc/core": "1.16.1",
    "turbo": "2.10.12",
    "typescript": "^7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "^5.0.5"
  }
}
