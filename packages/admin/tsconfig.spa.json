{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "noEmit": true,
    "incremental": false,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/agora-kit/**/*.ts",
    "src/agora-kit/**/*.tsx"
  ],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx", "dist/**", "node_modules"]
}
