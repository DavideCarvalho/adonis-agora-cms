{
  "name": "@adonis-agora/cms-admin",
  "version": "0.5.1",
  "description": "Admin SPA for @adonis-agora/cms — schema-driven list and edit views, TanStack Query, atomic UI. Ships embedded in a thin AdonisJS provider. Part of the Agora ecosystem.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cms_admin_provider": {
      "types": "./dist/provider/cms_admin_provider.d.ts",
      "import": "./dist/provider/cms_admin_provider.js",
      "default": "./dist/provider/cms_admin_provider.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./src/agora-kit/fonts.ts"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.3.0"
  },
  "dependencies": {
    "@adonis-agora/cms": "workspace:*",
    "@adonis-agora/cms-react": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@adonisjs/core": "7.5.0",
    "@base-ui/react": "1.9.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "happy-dom": "20.12.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
