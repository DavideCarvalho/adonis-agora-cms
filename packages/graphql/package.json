{
  "name": "@adonis-agora/cms-graphql",
  "version": "0.0.0",
  "description": "Optional GraphQL surface for @adonis-agora/cms \u2014 schema generated from the compiled spec, resolvers over the Local API, so access/hooks/tenancy/i18n keep applying.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./yoga": {
      "types": "./dist/yoga.d.ts",
      "import": "./dist/yoga.js",
      "default": "./dist/yoga.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-yoga": "^6.0.1"
  },
  "peerDependencies": {
    "@adonis-agora/cms": "workspace:*"
  },
  "devDependencies": {
    "@adonis-agora/cms": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@types/node": "^26.4.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
